{
  "expo": {
    "name": "BoredNotes",
    "slug": "borednotes",
    "scheme": "borednotes",
    "version": "2.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FBFAF3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.borednotes.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BoredNotes can tag your entries with where you wrote them.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "package": "com.borednotes.app"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afd82c89-84ff-4ae9-89b3-3a316f936cde"
      }
    }
  }
}
